# ── OVH API ──────────────────────────────────────────────────────────────────
 OVH_ENDPOINT=
 OVH_APP_KEY=
 OVH_APP_SECRET=
 OVH_CONSUMER_KEY=
 OVH_PROJECT_ID=
 OVH_CLUSTER_ID=
 OVH_NODEPOOL_ID=
 OVH_PRIVATE_NETWORK_ID=   # OVH Console → Network → Private Networks → Network ID column

# OVP Object Store (S3-compatible) credentials — set these in the OVH Object Store secret, not here
 OVH_S3_USER_ID=
 OVH_S3_ACCESS_KEY=
 OVH_S3_SECRET_KEY=
 OVH_S3_ENDPOINT=
 OVH_S3_BUCKET_BACKUPS=
 OVH_S3_BUCKET_ASSETS=
 
 TF_VAR_ovh_endpoint="${OVH_ENDPOINT:-ovh-ca}"
 TF_VAR_ovh_application_key="$OVH_APP_KEY"
 TF_VAR_ovh_application_secret="$OVH_APP_SECRET"
 TF_VAR_ovh_consumer_key="$OVH_CONSUMER_KEY"
 TF_VAR_ovh_cloud_project_service="$OVH_PROJECT_ID"
 TF_VAR_cluster_id="$OVH_CLUSTER_ID"

# ── OVH Object Store ──────────────────────────────────────────────────────────
 AWS_ENDPOINT_URL=s
 AWS_ACCESS_KEY_ID=
 AWS_SECRET_ACCESS_KEY=
 AWS_REGION=

# Cloudflare API
 CLOUDFLARE_ACCOUNT_ID=
 CLOUDFLARE_API_TOKEN=
 CF_ZONE_ID=
 CF_ACCOUNT_ID=

# ── Cluster access ────────────────────────────────────────────────────────────
 KUBECONFIG=~/.kube/config

 KEYCLOAK_ADMIN_PASSWORD=
 LITELLM_MASTER_KEY=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
 DATABASE_URL_HR=postgresql://cipuser:PASSWORD@postgres-postgresql.cip-infra:5432/cip_hr
 DATABASE_URL_PLATFORM=postgresql://cipuser:PASSWORD@postgres-postgresql.cip-infra:5432/cip_platform

 PG_USER_PASSWORD=
 PG_ADMIN_PASSWORD=


# ── LiteLLM — set on domain service pods only ─────────────────────────────────
# The Anthropic API key lives ONLY in the litellm-credentials K8s Secret.
# Domain services use the virtual key — not the real key.
 LITELLM_BASE_URL=http://litellm.cip-app.svc.cluster.local:4000
 DATABASE_URL_LITELLM=postgresql://cipuser:${PG_USER_PASSWORD}@postgres-postgresql.cip-infra:5432/cip_litellm
 LITELLM_VIRTUAL_KEY=
 ANTHROPIC_API_KEY=

# ── LiteLLM — set on the LiteLLM pod only (via litellm-credentials secret) ───
# ANTHROPIC_API_KEY=sk-ant-            # NEVER set this on domain service pods
# LITELLM_MASTER_KEY=sk-cip-master-   # Admin key — not for agents

# ── Langfuse ──────────────────────────────────────────────────────────────────
# false = Langfuse Cloud (dev default); true = self-hosted in-cluster (POC/prod)
 LANGFUSE_SELF_HOSTED=false

# Cloud mode — keys from cloud.langfuse.com
 LANGFUSE_PUBLIC_KEY=
 LANGFUSE_SECRET_KEY=
 LANGFUSE_HOST=https://cloud.langfuse.com

# Self-hosted mode — set these when LANGFUSE_SELF_HOSTED=true
# LANGFUSE_HOST=http://langfuse.cip-observe.svc.cluster.local:3000
# LANGFUSE_NEXTAUTH_SECRET=   # openssl rand -base64 32
# LANGFUSE_SALT=              # openssl rand -base64 32
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=

# ── Temporal Cloud ────────────────────────────────────────────────────────────
 TEMPORAL_ADDRESS=
 TEMPORAL_NAMESPACE=
 TEMPORAL_API_KEY=
 TEMPORAL_TASK_QUEUE_HR=cip-hr
 TEMPORAL_TASK_QUEUE_PLATFORM=cip-platform

# ── NATS ──────────────────────────────────────────────────────────────────────
 NATS_URL=nats://nats.cip-infra.svc.cluster.local:4222

# ── Keycloak ──────────────────────────────────────────────────────────────────
 KEYCLOAK_URL=https://keycloak-cip.idlevice.ca
 KEYCLOAK_REALM=cip-dev
 KEYCLOAK_CLIENT_ID=platform-api


# ── Dev tenant (fixed UUID for dev environment) ───────────────────────────────
 DEV_TENANT_ID=00000000-0000-0000-0000-000000000001

# Generated internal passwords with `openssl rand -base64 32` — these are only used in the dev environment, and should be rotated if leaked. In prod, these values are set to secure secrets in the OVH Object Store and injected into pods via K8s Secrets.

# Twilio for SMS
 TWILIO_ACCOUNT_SID=
 TWILIO_AUTH_TOKEN=
 TWILIO_PHONE_NUMBER=

# Resend for e-mails
 RESEND_API_KEY=
 RESEND_FROM_EMAIL=

# Azure / Teams
 MICROSOFT_APP_ID=
 MICROSOFT_APP_PASSWORD=
 MICROSOFT_APP_SECRET_ID=
 TENANT_ID=
 BOT_MESSAGING_ENDPOINT=
 AAD_APP_ID_URI=

 BOT_APP_ID=
 BOT_APP_PASSWORD=

# Azure / Teams
 MICROSOFT_APP_ID=
 MICROSOFT_APP_PASSWORD=
 MICROSOFT_APP_SECRET_ID=
 TENANT_ID=
 BOT_MESSAGING_ENDPOINT=
 AAD_APP_ID_URI=

OPENSTACK_USER=
OPENSTACK_PASSWORD=
