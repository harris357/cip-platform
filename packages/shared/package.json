{
  "name": "@cip/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "seed-prompts": "tsx scripts/seed-langfuse-prompts.ts"
  },
  "dependencies": {
    "@huggingface/jinja": "^0.5.8",
    "@langfuse/langchain": "^5.0.0",
    "@nats-io/jetstream": "^3.0.0",
    "@nats-io/kv": "^3.0.0",
    "@nats-io/nats-core": "^3.0.0",
    "@nats-io/transport-node": "^3.0.0",
    "@temporalio/activity": "^1.17.0",
    "@temporalio/client": "^1.17.0",
    "@temporalio/worker": "^1.17.0",
    "@temporalio/workflow": "^1.17.0",
    "express": "^4.19.0",
    "jose": "^5.3.0",
    "langfuse": "^3.0.0",
    "openai": "^6.0.0",
    "@opentelemetry/api": "^1.9.0",
    "pg": "^8.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
